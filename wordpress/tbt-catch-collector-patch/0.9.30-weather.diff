+    /** その時間が「降っていた」か。降水0.1mm以上、または天気が霧雨・雨・雪（51以上）。 */
+    private static function is_wet($code, $rain){
+        return ($code >= 51) || ($rain >= 0.1);
+    }
+
+    private static function wet_hours($codes, $rain){
+        $n = 0;
+        foreach ($codes as $i => $c) { if (self::is_wet($c, (float)($rain[$i] ?? 0))) $n++; }
+        return $n;
+    }
+
+    /**
+     * 時間帯を代表する天気。
+     *
+     * 0.9.29 までは「天気コードを大きい順に並べた真ん中」だけで決めていた。
+     * 雨が 6〜10時に降って昼に上がった日（9時間のうち雨4時間・合計4.9mm）が
+     * 「くもり」になり、釣りをしていた人の実感と合わなかった（2026-11-28）。
+     *
+     * 0.9.30 から：雷があれば雷雨。降った時間が全体の3分の1以上、または合計2mm以上なら、
+     * 降った時間の中の真ん中の天気にする（合計1mm以上なら「霧雨」ではなく「雨」）。
+     * それ以外は、これまでどおり全体の真ん中。
+     * ラベルの種類は増やさない（集計の「天気」の切り口が細かく割れないように）。
+     */
+    private static function dominant_code($codes, $rain = []){
+        $n = count($codes);
+        if (!$n) return null;
+        $sorted = $codes;
+        rsort($sorted);
+        if ($sorted[0] >= 95) return $sorted[0];
+        $wet = [];
+        $wet_n = 0;
+        $sum = 0.0;
+        foreach ($codes as $i => $c) {
+            $r = (float)($rain[$i] ?? 0);
+            $sum += $r;
+            if (self::is_wet($c, $r)) { $wet_n++; if ($c >= 51) $wet[] = $c; }
+        }
+        if ($wet_n * 3 >= $n || $sum >= 2.0) {
+            rsort($wet);
+            $c = $wet ? $wet[(int)floor(count($wet) / 2)] : 61;
+            if ($c <= 57 && $sum >= 1.0) $c = 61; // 霧雨の扱いでも、まとまって降っていれば「雨」
+            return $c;
+        }
+        return $sorted[(int)floor($n / 2)];
     }
 
