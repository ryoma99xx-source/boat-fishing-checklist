diff -ru new/tbt-site-insights/inc/google.php v044/tbt-site-insights/inc/google.php
--- new/tbt-site-insights/inc/google.php	2026-11-13 04:35:20.501586680 +0000
+++ v044/tbt-site-insights/inc/google.php	2026-11-13 08:15:27.624623647 +0000
@@ -67,17 +67,23 @@
 	if ( is_wp_error( $token ) ) {
 		return $token;
 	}
-	$res = wp_remote_post(
-		$url,
-		array(
-			'timeout' => 40,
-			'headers' => array(
-				'Authorization' => 'Bearer ' . $token,
-				'Content-Type'  => 'application/json',
-			),
-			'body'    => wp_json_encode( $body ),
-		)
-	);
+	// Googleが応答しないことがたまにあるので、通信エラー・タイムアウト・5xx のときは1回だけやり直す
+	for ( $try = 0; $try < 2; $try++ ) {
+		$res = wp_remote_post(
+			$url,
+			array(
+				'timeout' => $try ? 30 : 20,
+				'headers' => array(
+					'Authorization' => 'Bearer ' . $token,
+					'Content-Type'  => 'application/json',
+				),
+				'body'    => wp_json_encode( $body ),
+			)
+		);
+		if ( ! is_wp_error( $res ) && wp_remote_retrieve_response_code( $res ) < 500 ) {
+			break;
+		}
+	}
 	if ( is_wp_error( $res ) || 200 !== wp_remote_retrieve_response_code( $res ) ) {
 		return new WP_Error( 'tbtsi_google', tbtsi_http_error( $res ) );
 	}
